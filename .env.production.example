# ══════════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# There are NO working defaults in here, deliberately. docker-compose.prod
# uses ${VAR:?message} on every secret, so a missing value stops the stack
# with a named error instead of quietly starting with the development
# password. A dev credential surviving into production is the single most
# common way small deployments get compromised.
#
# NEVER COMMIT .env.production. It is covered by .gitignore's `.env.*`.
# ══════════════════════════════════════════════════════════════════════


# ── Database ─────────────────────────────────────────────────────────
# Postgres publishes no host port in production; these are used inside the
# compose network only. Generate the password, do not invent one:
#
#   openssl rand -base64 24
#
POSTGRES_USER=brs
POSTGRES_PASSWORD=
POSTGRES_DB=brs


# ── Object storage ───────────────────────────────────────────────────
#
# WHAT THE FAÇADE NEEDS: only STORAGE_PUBLIC_BASE_URL. It issues asset
# URLs and never reads or writes a bucket, so it holds no credentials —
# it imports @brs/storage/url, which has no S3 client in it at all.
#
# WHAT NEEDS CREDENTIALS: the upload script, run by an operator, and
# nothing else. Those may live in a separate .env used only for uploads.
#
# The public base of the bucket or the CDN in front of it. This is what
# every <img> on the site points at.
STORAGE_PUBLIC_BASE_URL=https://assets.example.org

# Credentials — required ONLY to run `pnpm --filter @brs/storage upload`,
# and by the `self-hosted-storage` profile if you run MinIO yourself.
STORAGE_PROVIDER=s3
S3_BUCKET=brs-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Cloudflare R2:  https://<account-id>.r2.cloudflarestorage.com  · path-style false
# AWS S3:         leave empty, the SDK resolves it               · path-style false
# Self-hosted:    http://minio:9000                              · path-style true
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false


# ── Public URLs — BAKED IN AT BUILD TIME ─────────────────────────────
#
# These two are compiled into the JavaScript by `docker compose build`.
# Changing them requires a REBUILD, not a restart. That is what
# NEXT_PUBLIC_ means, and apps/web/Dockerfile explains why no runtime
# substitution layer was added.
#
# NEXT_PUBLIC_BRS_API must be reachable FROM A BROWSER — it is not an
# internal compose hostname. `http://api:8787` will not work.
NEXT_PUBLIC_BRS_API=https://api.example.org
NEXT_PUBLIC_STORAGE_BASE_URL=https://assets.example.org


# ── Ports on the host ────────────────────────────────────────────────
# All bound to 127.0.0.1 by compose. A reverse proxy terminating TLS is
# the only public path in.
WEB_PORT=8080
API_PORT=8787
DIRECTUS_PORT=8055
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001


# ── Directus — `authoring` profile only ──────────────────────────────
# Not in the read path. The public site is unaffected whether this runs
# or not, so leave it down except when someone is editing.
#
#   openssl rand -base64 32
DIRECTUS_SECRET=
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=
DIRECTUS_PUBLIC_URL=https://cms.example.org


# ── Image tagging ────────────────────────────────────────────────────
# Set to a git SHA in CI so a rollback is `IMAGE_TAG=<previous> up -d`.
IMAGE_TAG=latest


# ── SharePoint sync (§9.3, blocked on §16.12) ────────────────────────
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SITE_ID=
GRAPH_DRIVE_ID=

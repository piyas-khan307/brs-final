{
  "openapi": "3.1.0",
  "info": {
    "title": "BRS Content API",
    "version": "1.0.0",
    "description": "The BRS content contract. Frontend-agnostic DTOs. Additive-only within a version; breaking changes ship as /v2 with /v1 retained for >= 6 months. MemberDTO deliberately has no contact field (implementation_plan.md §12.1)."
  },
  "servers": [
    {
      "url": "https://api.example.invalid",
      "description": "Set at deploy time"
    }
  ],
  "paths": {
    "/v1/events": {
      "get": {
        "summary": "List events",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/EventDTO"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "total": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "data",
                    "nextCursor",
                    "total"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/{slug}": {
      "get": {
        "summary": "Event by slug",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDTO"
                }
              }
            }
          }
        }
      }
    },
    "/v1/committees": {
      "get": {
        "summary": "List committees",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CommitteeDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/members": {
      "get": {
        "summary": "List members (never includes contact data — §12.1)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MemberDTO"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "total": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "data",
                    "nextCursor",
                    "total"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/achievements": {
      "get": {
        "summary": "List achievements",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AchievementDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{slug}": {
      "get": {
        "summary": "Project by slug",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDTO"
                }
              }
            }
          }
        }
      }
    },
    "/v1/posts": {
      "get": {
        "summary": "List posts",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PostDTO"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "total": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "data",
                    "nextCursor",
                    "total"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/partners": {
      "get": {
        "summary": "List partners",
        "responses": {
          "200": {
            "description": "OK",
            "content": {

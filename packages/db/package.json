{
  "name": "@brs/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL schema — the source of truth (Plane 1). Directus reads this; it does not define it.",
  "scripts": {
    "migrate": "node scripts/migrate.mjs",
    "verify": "node scripts/verify-schema.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "test:constraints": "psql \"${DATABASE_URL:-postgres://brs:brs@localhost:5433/brs}\" -v ON_ERROR_STOP=0 -f scripts/test-constraints.sql",
    "typecheck": "echo 'no TS in @brs/db'",
    "seed:collections": "node --env-file-if-exists=../../.env --import tsx scripts/seed-collections.ts",
    "seed:committee": "node --env-file-if-exists=../../.env --import tsx scripts/seed-committee.ts"
  },
  "dependencies": {
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1"
  }
}

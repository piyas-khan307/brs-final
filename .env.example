# ─────────────────────────────────────────────────────────────
# Copy to .env and fill. NEVER commit .env — §12.2.
#
# The values below are the LOCAL DEVELOPMENT stack and work as-is:
#   docker compose up -d
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Plane 4: delivery frontend ────────────────────────────────
# The ONLY backend coordinate the frontend is allowed to know.
NEXT_PUBLIC_BRS_API=http://localhost:8787

# Where a browser fetches images from. Baked into the static export at
# build time, so changing it needs a rebuild — that is the trade static
# export makes for having no server at runtime.
NEXT_PUBLIC_STORAGE_BASE_URL=http://localhost:9000/brs-assets

# ── Plane 3: API facade ───────────────────────────────────────
BRS_API_URL=http://localhost:8787
# Internal only. The facade is the sole CMS-aware component.
DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=

# ── Plane 1: data ─────────────────────────────────────────────
# 5433, not 5432 — the container is mapped off the default port so it
# cannot collide with a system postgresql service. See docker-compose.yml.
DATABASE_URL=postgres://brs:brs@localhost:5433/brs

# ─────────────────────────────────────────────────────────────
# Object storage
#
# The variables are S3_*, not R2_*, on purpose. §16.13 has not decided
# between providers, and ONE S3 adapter drives all of these unchanged:
#
#   Cloudflare R2 · AWS S3 · MinIO · Backblaze B2 · DigitalOcean Spaces
#   · Wasabi · Ceph
#
# Naming them R2_* would bake in a decision nobody has made, and would be
# a small permanent lie if the club lands on AWS.
#
# Azure Blob is the one that is NOT a config change: it has no
# S3-compatible endpoint, so it needs a second adapter implementing
# StorageAdapter (~120 lines). The interface exists so that stays cheap.
# ─────────────────────────────────────────────────────────────
STORAGE_PROVIDER=s3

# Local MinIO, from docker-compose.yml. Working defaults.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=brs-assets
S3_ACCESS_KEY_ID=brs
S3_SECRET_ACCESS_KEY=brs-dev-secret
S3_REGION=auto
# MinIO and Ceph address buckets as host/bucket/key; AWS and R2 use
# bucket.host/key. The wrong value is an opaque 301 with an empty body.
S3_FORCE_PATH_STYLE=true

# What the adapter hands to the browser. A CDN hostname in production;
# the bucket origin here.
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/brs-assets

# ── Production: replace the block above, change nothing else ──
#
# Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_FORCE_PATH_STYLE=false
#   STORAGE_PUBLIC_BASE_URL=https://assets.example.org
#
# AWS S3 behind CloudFront:
#   S3_ENDPOINT=                     # leave empty; the SDK resolves it
#   S3_REGION=ap-southeast-1
#   S3_FORCE_PATH_STYLE=false
#   STORAGE_PUBLIC_BASE_URL=https://dxxxxxxxx.cloudfront.net

# ── SharePoint sync (§9.3, blocked on §16.12) ─────────────────
# App-only auth, Sites.Selected scope. Narrowest viable grant.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SITE_ID=
GRAPH_DRIVE_ID=

# ── Plane 2: the uploader ─────────────────────────────────────
# Shared secret between Directus/operator scripts and @brs/ingest. The
# service REFUSES TO START without it rather than defaulting to open — it
# writes to object storage, and that is not something to leave one missing
# variable away. Generate with:  openssl rand -base64 32
INGEST_TOKEN=change-me-openssl-rand-base64-32
INGEST_URL=http://localhost:8790

# ── Publish → rebuild ─────────────────────────────────────────────
# The site is a STATIC EXPORT: pressing "publish" in the admin panel
# changes the database and nothing else until something rebuilds the
# site. Point this at whatever does that — a GitHub Actions
# repository_dispatch URL, a Netlify/Vercel build hook, or a webhook on
# the club's own server. Left unset, `pnpm --filter @brs/cms configure`
# says so loudly rather than wiring up a hook to nowhere.
REBUILD_WEBHOOK_URL=
REBUILD_WEBHOOK_TOKEN=

# Where the browser reaches Directus from the /admin area. Public by
# nature — it is a CMS the club signs into, not a secret. Must be in
# Directus's CORS_ORIGIN or every admin request fails silently in the
# console.
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
